@using Naydovich.Domain
@using Naydovich.Blazor.Services
@using Naydovich.Domain.Entities

@if (Cleaner != null)
{
    <div class="card mt-5" style="width: 18rem;">
        <img src="@Cleaner.Image" class="card-img-top" alt="...">
        <div class="card-body">
            <h5 class="card-title">@Cleaner.Name</h5>
            <p class="card-text">@Cleaner.Description</p>
            <h4 class="badge bg-info">@Cleaner.Power мощность</h4>
        </div>
    </div>
}
@code {
    [Parameter]
    public Cleaner Cleaner { get; set; }
    [Parameter]
    public EventCallback<Cleaner> CleanerChanged { get; set; }
}